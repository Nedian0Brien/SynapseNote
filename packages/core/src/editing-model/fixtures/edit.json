    "actions": [
      {
        "type": "key",
        "key": "Shift-Enter"
      }
    ],
    "after": "ab\\\n│cd"
  },
  {
    "id": "enter-list",
    "group": "edit.enter-list",
    "rule": "7",
    "before": "- a│",
    "actions": [
      {
        "type": "key",
        "key": "Enter"
      }
    ],
    "after": "- a\n- │"
  },
  {
    "id": "enter-ordered",
    "group": "edit.enter-list",
    "rule": "7",
    "before": "1. a│",
    "actions": [
      {
        "type": "key",
        "key": "Enter"
      }
    ],
    "after": "1. a\n2. │"
  },
  {
    "id": "enter-list-empty",
    "group": "edit.enter-list-empty",
    "rule": "7",
    "before": "- a\n- │",
    "actions": [
      {
        "type": "key",
        "key": "Enter"
      }
    ],
    "after": "- a\n\n│"
  },
  {
    "id": "enter-heading",
    "group": "edit.enter-heading",
    "rule": "7",
    "before": "# 제목│",
    "actions": [
      {
        "type": "key",
        "key": "Enter"
      }
    ],
    "after": "# 제목\n\n│"
  },
  {
    "id": "tab-list",
    "group": "edit.tab-list",
    "rule": "7",
    "before": "- a\n- │b",
    "actions": [
      {
        "type": "key",
        "key": "Tab"
      }
    ],
    "after": "- a\n  - │b"
  },
  {
    "id": "shift-tab-list",
    "group": "edit.tab-list",
    "rule": "7",
    "before": "- a\n  - │b",
    "actions": [
      {
        "type": "key",
        "key": "Shift-Tab"
      }
    ],
    "after": "- a\n- │b"
  },
  {
    "id": "paste-plain",
    "group": "edit.paste-plain",
    "rule": "8",
    "before": "a│",
    "actions": [
      {
        "type": "paste",
        "text": "*b* [c]"
      }
