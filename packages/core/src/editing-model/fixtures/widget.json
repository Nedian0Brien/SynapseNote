[
  {
    "id": "code-body-byte-range",
    "group": "widget.code-body",
    "rule": "3",
    "before": "before\n\n```js title=x\nold\n```\n\nafter",
    "from": 8,
    "edit": { "type": "code-body", "text": "new" },
    "after": "before\n\n```js title=x\nnew\n```\n\nafter"
  },
  {
    "id": "code-language-byte-range",
    "group": "widget.code-language",
    "rule": "3",
    "before": "```js title=x\nold\n```",
    "from": 0,
    "edit": { "type": "code-language", "text": "ts" },
    "after": "```ts title=x\nold\n```"
  },
  {
    "id": "indented-code-body",
    "group": "widget.code-body",
    "rule": "3",
    "before": "before\n\n    old\n    next\n\nafter",
    "from": 8,
    "edit": { "type": "code-body", "text": "new\nnext" },
    "after": "before\n\n    new\n    next\n\nafter"
  },
  {
    "id": "tab-indented-code-body",
    "group": "widget.code-body",
    "rule": "3",
    "before": "\told\n\tnext",
    "from": 0,
    "edit": { "type": "code-body", "text": "new\nnext" },
    "after": "\tnew\n\tnext"
  },
  {
    "id": "code-body-fence-content",
    "group": "widget.code-body",
    "rule": "3",
    "before": "```js\nold\n```",
    "from": 0,
    "edit": { "type": "code-body", "text": "new\n```\nend" },
    "after": "````js\nnew\n```\nend\n````"
  },
  {
    "id": "table-cell-byte-range",
    "group": "widget.table-cell",
    "rule": "3",
    "before": "| a | b |\n| --- | :--- |\n| **x** | y |",
    "from": 0,
    "edit": { "type": "table-cell", "row": 1, "column": 0, "text": "**z**" },
    "after": "| a | b |\n| --- | :--- |\n| **z** | y |"
  },
  {
    "id": "code-body-indented-closing-fence",
    "group": "widget.code-body",
    "rule": "3",
    "before": "```js\nold\n  ```",
    "from": 0,
    "edit": { "type": "code-body", "text": "new\n```\nend" },
    "after": "````js\nnew\n```\nend\n  ````"
  },
  {
    "id": "table-cell-escape-pipe",
    "group": "widget.table-cell",
    "rule": "3",
    "before": "| a | b |\n| --- | --- |\n|  | y |",
    "from": 0,
    "edit": { "type": "table-cell", "row": 1, "column": 0, "text": "a|b" },
    "after": "| a | b |\n| --- | --- |\n|  a\\|b| y |"
  },
  {
    "id": "math-dollar-body",
    "group": "widget.math-body",
    "rule": "3",
    "before": "before\n\n$$\nx^2\n$$\n\nafter",
    "from": 8,
    "edit": { "type": "diagram-body", "text": "y^2" },
    "after": "before\n\n$$\ny^2\n$$\n\nafter"
  },
  {
    "id": "math-fence-body",
    "group": "widget.math-body",
    "rule": "3",
    "before": "```math\nx^2\n```",
    "from": 0,
    "edit": { "type": "diagram-body", "text": "y^2" },
    "after": "```math\ny^2\n```"
  },
  {
    "id": "mermaid-fence-body",
    "group": "widget.mermaid-body",
    "rule": "3",
    "before": "```mermaid\ngraph TD; A-->B\n```",
    "from": 0,
    "edit": { "type": "diagram-body", "text": "graph TD; B-->C" },
    "after": "```mermaid\ngraph TD; B-->C\n```"
  },
  {
    "id": "gfm-callout-body",
    "group": "widget.callout-body",
    "rule": "3",
    "before": "before\n\n> [!NOTE] Title\n> first **bold**\n> second\n\nafter",
    "from": 8,
    "edit": { "type": "container-body", "text": "first **strong**\nsecond" },
    "after": "before\n\n> [!NOTE] Title\n> first **strong**\n> second\n\nafter"
  },
  {
    "id": "gfm-callout-line-break",
    "group": "widget.callout-body",
    "rule": "3",
    "before": "> [!TIP]\n> alpha beta",
    "from": 0,
    "edit": { "type": "container-body", "text": "alpha\nbeta" },
    "after": "> [!TIP]\n> alpha\n> beta"
  },
  {
    "id": "gfm-callout-join-lines",
    "group": "widget.callout-body",
    "rule": "3",
    "before": "> [!TIP]\n> alpha\n> beta",
    "from": 0,
    "edit": { "type": "container-body", "text": "alphabeta" },
    "after": "> [!TIP]\n> alphabeta"
  },
  {
    "id": "gfm-callout-title",
    "group": "widget.callout-attribute",
    "rule": "3",
    "before": "> [!NOTE] Old title\n> body",
    "from": 0,
    "edit": { "type": "container-title", "text": "New title" },
    "after": "> [!NOTE] New title\n> body"
  },
  {
    "id": "gfm-callout-type",
    "group": "widget.callout-attribute",
    "rule": "3",
    "before": "> [!NOTE] Title\n> body",
    "from": 0,
    "edit": { "type": "container-type", "text": "warning" },
    "after": "> [!WARNING] Title\n> body"
  },
  {
    "id": "gfm-callout-empty-body",
    "group": "widget.callout-body",
    "rule": "3",
    "before": "> [!NOTE]",
    "from": 0,
    "edit": { "type": "container-body", "text": "new" },
    "after": "> [!NOTE]\n> new"
  },
  {
    "id": "mdx-callout-body",
    "group": "widget.callout-body",
    "rule": "3",
    "before": "<Callout type=\"warning\" title=\"Heads up\">\nold **bold**\n</Callout>",
    "from": 0,
    "edit": { "type": "container-body", "text": "new **bold**" },
    "after": "<Callout type=\"warning\" title=\"Heads up\">\nnew **bold**\n</Callout>"
  },
  {
    "id": "mdx-callout-title",
    "group": "widget.callout-attribute",
    "rule": "3",
    "before": "<Callout type=\"note\" title=\"Old\">\nbody\n</Callout>",
    "from": 0,
    "edit": { "type": "container-title", "text": "New" },
    "after": "<Callout type=\"note\" title=\"New\">\nbody\n</Callout>"
  },
  {
    "id": "mdx-callout-add-title",
    "group": "widget.callout-attribute",
    "rule": "3",
    "before": "<Callout type=\"note\">\nbody\n</Callout>",
    "from": 0,
    "edit": { "type": "container-title", "text": "Added" },
    "after": "<Callout type=\"note\" title=\"Added\">\nbody\n</Callout>"
  },
  {
    "id": "mdx-accordion-body",
    "group": "widget.accordion-body",
    "rule": "3",
    "before": "<Accordion title=\"Details\">\nold\n</Accordion>",
    "from": 0,
    "edit": { "type": "container-body", "text": "new" },
    "after": "<Accordion title=\"Details\">\nnew\n</Accordion>"
  },
  {
    "id": "mdx-accordion-title",
    "group": "widget.accordion-attribute",
    "rule": "3",
    "before": "<Accordion title=\"Details\">\nbody\n</Accordion>",
    "from": 0,
    "edit": { "type": "container-title", "text": "More" },
    "after": "<Accordion title=\"More\">\nbody\n</Accordion>"
  },
  {
    "id": "html-details-title",
    "group": "widget.accordion-attribute",
    "rule": "3",
    "before": "<details open name=\"group\"><summary>Old</summary>body</details>",
    "from": 0,
    "edit": { "type": "container-title", "text": "New" },
    "after": "<details open name=\"group\"><summary>New</summary>body</details>"
  },
  {
    "id": "html-details-body",
    "group": "widget.accordion-body",
    "rule": "3",
    "before": "before\n\n<details open><summary>Details</summary>\n\nold\n\n</details>\n\nafter",
    "from": 8,
    "edit": { "type": "container-body", "text": "\nnew\n" },
    "after": "before\n\n<details open><summary>Details</summary>\n\nnew\n\n</details>\n\nafter"
  },
  {
    "id": "tabs-second-label",
    "group": "widget.tabs-label",
    "rule": "3",
    "before": "<Tabs id=\"set\">\n<Tab label=\"One\">\nalpha\n</Tab>\n<Tab label=\"Two\">\nbeta\n</Tab>\n</Tabs>",
    "from": 0,
    "edit": { "type": "tabs-label", "index": 1, "text": "Other" },
    "after": "<Tabs id=\"set\">\n<Tab label=\"One\">\nalpha\n</Tab>\n<Tab label=\"Other\">\nbeta\n</Tab>\n</Tabs>"
  },
  {
    "id": "tabs-first-body",
    "group": "widget.tabs-body",
    "rule": "3",
    "before": "<Tabs>\n<Tab label=\"One\">\nalpha\n</Tab>\n<Tab label=\"Two\">\nbeta\n</Tab>\n</Tabs>",
    "from": 0,
    "edit": { "type": "tabs-body", "index": 0, "text": "new" },
    "after": "<Tabs>\n<Tab label=\"One\">\nnew\n</Tab>\n<Tab label=\"Two\">\nbeta\n</Tab>\n</Tabs>"
  },
  {
    "id": "tabs-add-panel",
    "group": "widget.tabs-body",
    "rule": "3",
    "before": "<Tabs>\n<Tab label=\"One\">\nalpha\n</Tab>\n</Tabs>",
    "from": 0,
    "edit": { "type": "tabs-add", "label": "Tab 2" },
    "after": "<Tabs>\n<Tab label=\"One\">\nalpha\n</Tab>\n<Tab label=\"Tab 2\">\n\n</Tab>\n</Tabs>"
  },
  {
    "id": "tabs-remove-panel",
    "group": "widget.tabs-body",
    "rule": "3",
    "before": "<Tabs>\n<Tab label=\"One\">\nalpha\n</Tab>\n<Tab label=\"Two\">\nbeta\n</Tab>\n</Tabs>",
    "from": 0,
    "edit": { "type": "tabs-remove", "index": 0 },
    "after": "<Tabs>\n<Tab label=\"Two\">\nbeta\n</Tab>\n</Tabs>"
  },
  {
    "id": "markdown-image-src",
    "group": "widget.media-src",
    "rule": "3",
    "before": "a ![Alt](old.png) z",
    "from": 2,
    "edit": { "type": "media-src", "text": "new.png" },
    "after": "a ![Alt](new.png) z"
  },
  {
    "id": "reference-image-src",
    "group": "widget.media-src",
    "rule": "3",
    "before": "a ![Alt][pic] z\n\n[pic]: old.png \"Caption\"",
    "from": 2,
    "edit": { "type": "media-src", "text": "new.png" },
    "after": "a ![Alt][pic] z\n\n[pic]: new.png \"Caption\""
  },
  {
    "id": "reference-image-alt",
    "group": "widget.media-label",
    "rule": "3",
    "before": "![Old][]\n\n[old]: image.png",
    "from": 0,
    "edit": { "type": "media-label", "text": "New" },
    "after": "![New][Old]\n\n[old]: image.png"
  },
  {
    "id": "reference-shortcut-alt",
    "group": "widget.media-label",
    "rule": "3",
    "before": "![pic]\n\n[pic]: image.png",
    "from": 0,
    "edit": { "type": "media-label", "text": "Other" },
    "after": "![Other][pic]\n\n[pic]: image.png"
  },
  {
    "id": "reference-shortcut-src",
    "group": "widget.media-src",
    "rule": "3",
    "before": "![pic]\n\n[pic]: old.png\n[pic]: later.png",
    "from": 0,
    "edit": { "type": "media-src", "text": "new.png" },
    "after": "![pic]\n\n[pic]: new.png\n[pic]: later.png"
  },
  {
    "id": "reference-definition-target",
    "group": "widget.reference-target",
    "rule": "3",
    "before": "![Alt][pic]\n\n[pic]: <old%20image.png> \"Caption\"",
    "from": 13,
    "edit": { "type": "reference-target", "text": "new image.png" },
    "after": "![Alt][pic]\n\n[pic]: <new%20image.png> \"Caption\""
  },
  {
    "id": "markdown-image-alt",
    "group": "widget.media-label",
    "rule": "3",
    "before": "![Old](a.png \"Title\")",
    "from": 0,
    "edit": { "type": "media-label", "text": "New" },
    "after": "![New](a.png \"Title\")"
  },
  {
    "id": "wiki-image-target",
    "group": "widget.media-src",
    "rule": "3",
    "before": "![[old.png]]",
    "from": 0,
    "edit": { "type": "media-src", "text": "new.png" },
    "after": "![[new.png]]"
  },
  {
    "id": "wiki-file-alias",
    "group": "widget.media-label",
    "rule": "3",
    "before": "![[report.pdf]]",
    "from": 0,
    "edit": { "type": "media-label", "text": "Report" },
    "after": "![[report.pdf|Report]]"
  },
  {
    "id": "mdx-image-alt",
    "group": "widget.media-label",
    "rule": "3",
    "before": "<img src=\"a.png\" alt=\"Old\" />",
    "from": 0,
    "edit": { "type": "media-label", "text": "New" },
    "after": "<img src=\"a.png\" alt=\"New\" />"
  },
  {
    "id": "mdx-file-name",
    "group": "widget.media-label",
    "rule": "3",
    "before": "<File src=\"report.pdf\" name=\"Old\" />",
    "from": 0,
    "edit": { "type": "media-label", "text": "New" },
    "after": "<File src=\"report.pdf\" name=\"New\" />"
  },
  {
    "id": "mdx-embed-src",
    "group": "widget.media-src",
    "rule": "3",
    "before": "<Embed src=\"https://old.example\" />",
    "from": 0,
    "edit": { "type": "media-src", "text": "https://new.example" },
    "after": "<Embed src=\"https://new.example\" />"
  },
  {
    "id": "mdx-embed-add-title",
    "group": "widget.media-label",
    "rule": "3",
    "before": "<Embed src=\"https://example.com\" />",
    "from": 0,
    "edit": { "type": "media-label", "text": "Example" },
    "after": "<Embed src=\"https://example.com\" title=\"Example\" />"
  },
  {
    "id": "mdx-database-reference",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<DatabaseView databaseId=\"db_old\" sourceId=\"ds_1\" viewId=\"view_1\" />",
    "from": 0,
    "edit": { "type": "mdx-prop", "key": "databaseId", "text": "db_new" },
    "after": "<DatabaseView databaseId=\"db_new\" sourceId=\"ds_1\" viewId=\"view_1\" />"
  },
  {
    "id": "mdx-pdf-source",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<Pdf src=\"old.pdf\" />",
    "from": 0,
    "edit": { "type": "mdx-prop", "key": "src", "text": "new.pdf" },
    "after": "<Pdf src=\"new.pdf\" />"
  },
  {
    "id": "mdx-boolean-literal",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<Custom enabled data-id=\"keep\" />",
    "from": 0,
    "edit": { "type": "mdx-prop-literal", "key": "enabled", "value": false },
    "after": "<Custom enabled={false} data-id=\"keep\" />"
  },
  {
    "id": "mdx-number-literal",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<Custom count={1} title=\"keep\" />",
    "from": 0,
    "edit": { "type": "mdx-prop-literal", "key": "count", "value": 2 },
    "after": "<Custom count={2} title=\"keep\" />"
  },
  {
    "id": "mdx-json-literal",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<DatabaseView viewOverrides={{\"limit\":10}} viewId=\"keep\" />",
    "from": 0,
    "edit": { "type": "mdx-prop-literal", "key": "viewOverrides", "value": { "limit": 20 } },
    "after": "<DatabaseView viewOverrides={{\"limit\":20}} viewId=\"keep\" />"
  },
  {
    "id": "mdx-add-literal",
    "group": "widget.mdx-prop",
    "rule": "3",
    "before": "<Custom title=\"keep\" />",
    "from": 0,
    "edit": { "type": "mdx-prop-literal", "key": "enabled", "value": true },
    "after": "<Custom title=\"keep\" enabled={true} />"
  },
  {
    "id": "mdx-custom-body",
    "group": "widget.mdx-body",
    "rule": "3",
    "before": "<Custom title=\"X\">\nold **bold**\n</Custom>",
    "from": 0,
    "edit": { "type": "mdx-body", "text": "new **bold**" },
    "after": "<Custom title=\"X\">\nnew **bold**\n</Custom>"
  },
  {
    "id": "mdx-empty-body",
    "group": "widget.mdx-body",
    "rule": "3",
    "before": "<Custom />",
    "from": 0,
    "edit": { "type": "mdx-body", "text": "new" },
    "after": "<Custom >\nnew\n</Custom>"
  }
]
