<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- sync sends its requests to paired devices; and the sandboxed WebKit content process, which draws formulas, diagrams and PDFs, does not launch without it -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- sync: other paired devices on the network send their requests to this one -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- the vault folder the person picks in an open or save panel -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- reopening that folder on the next launch -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
