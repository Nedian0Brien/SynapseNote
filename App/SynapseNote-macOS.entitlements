<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- the sandboxed WebKit content process does not launch without it; the editor page reaches nothing outside the app -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- the vault folder the person picks in an open or save panel -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- reopening that folder on the next launch -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
